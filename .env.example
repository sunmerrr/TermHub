# TermHub 환경변수 예시

# 대시보드 포트 (기본값: 8081)
PORT=8081

# 대시보드 비밀번호 (반드시 변경할 것)
DASHBOARD_PASSWORD=changeme

# Discord 알림 웹훅 (선택)
DISCORD_WEBHOOK=

# Discord 경고 알림 웹훅 (선택, 미설정 시 DISCORD_WEBHOOK 사용)
DISCORD_ALERT_WEBHOOK=

# Discord 봇 이름·아바타 (선택, 기본: lulu + 로봇 아바타)
# 이름만 지정하면 아바타는 웹훅에 설정된 기본 이미지를 쓴다
DISCORD_USERNAME=
DISCORD_AVATAR_URL=

# 터널 헬스체크 활성화 (1로 설정 시 60초마다 터널 상태 확인)
ENABLE_TUNNEL_HEALTHCHECK=0

# ── 미리보기 탭 기능 ──────────────────────────────────
# 터미널 로그에서 localhost:XXXX 패턴 감지 시 미리보기 탭 자동 생성
ENABLE_PREVIEW=1

# 포트 감지 시 cloudflared 터널 자동 생성 (원격 접근용)
# cloudflared가 PATH에 설치되어 있어야 합니다.
# 설치: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
PREVIEW_TUNNEL=0

# ── 이 컴퓨터 설정 (예전 config.json 대신 — 둘 다 있으면 여기 값이 우선) ──
# 로그인 화면·브라우저 탭에 보일 이 컴퓨터의 이름 (비우면 컴퓨터 이름)
TERMHUB_NAME=
# 새 터미널을 열 기본 폴더
BASE_PATH=
# 새 터미널에서 실행할 기본 명령 (기본: claude)
DEFAULT_COMMAND=claude
# 즐겨찾기 폴더 — 쉼표로 구분 (처음 접속한 브라우저에 한 번 채워진다)
FAVORITES=

# ── 그 밖의 선택 항목 (기본값) ──
# TUNNEL_HEALTHCHECK_INTERVAL_MS=30000
# TUNNEL_HEALTHCHECK_FAILURE_LIMIT=2
# ENABLE_PREVIEW_PORT_SCAN=0
# PREVIEW_ALLOWED_PORTS=3000,5173
# PREVIEW_HEALTH_INTERVAL_MS=3600000
# PREVIEW_CLOSE_FAILURES=1
# PORT_SCAN_INTERVAL_MS=3000
# IGNORED_PREVIEW_PORT_TTL_MS=60000
# PUSH_CONTACT=mailto:admin@localhost
# PUSH_COOLDOWN_MS=60000
# DONE_PUSH_MIN_MS=20000
# UPLOAD_MAX_MB=20
# UPLOAD_RETENTION_DAYS=7
# INPUT_ENTER_DELAY_MS=150
# COMMIT_MESSAGE_MODEL=haiku
